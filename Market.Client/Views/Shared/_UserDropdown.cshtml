@using System.Security.Claims

@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="navbar-item dropdown">
        <button class="navbar-link dropdown-toggle d-flex align-items-center" 
                type="button" 
                id="userDropdown" 
                data-bs-toggle="dropdown" 
                aria-expanded="false">
            <div class="user-avatar-wrapper me-2">
                @{
                    var imageUrl = ViewBag.UserImageUrl;
                    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? "User";
                    var initials = GetInitials(userName);
                }
                @if (!string.IsNullOrEmpty(imageUrl))
                {
                    <img src="@imageUrl" 
                         alt="@userName" 
                         class="rounded-circle user-avatar"
                         style="width: 32px; height: 32px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle user-avatar-icon bg-primary text-white d-flex align-items-center justify-content-center"
                         style="width: 32px; height: 32px; font-weight: bold; font-size: 14px;">
                        @initials
                    </div>
                }
            </div>
            <span class="user-name d-none d-md-inline">@userName</span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
            <li>
                <a class="dropdown-item" asp-controller="User" asp-action="Settings">
                    <i class="fa fa-cog me-2"></i>Settings
                </a>
            </li>
            <li>
                <a class="dropdown-item" href="mailto:@User.FindFirst(ClaimTypes.Email)?.Value">
                    <i class="fa fa-envelope me-2"></i>@User.FindFirst(ClaimTypes.Email)?.Value
                </a>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                    <i class="fa fa-sign-out-alt me-2"></i>Logout
                </a>
            </li>
        </ul>
    </div>
}

@functions {
    private string GetInitials(string fullName)
    {
        if (string.IsNullOrEmpty(fullName))
            return "U";

        var parts = fullName.Trim().Split(' ');
        if (parts.Length == 1)
            return fullName.Substring(0, 1).ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}
