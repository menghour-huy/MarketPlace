<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketPlace</title>

    @* No-flash theme: runs before CSS renders to avoid a flicker *@
    <script>
        (function () {
            var saved = localStorage.getItem('app-theme');
            if (!saved) {
                saved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>

    @* Color Admin v5.3.1 — vendor bundle (Bootstrap 5 + Font Awesome) *@
    <link rel="stylesheet" href="~/lib/theme/dist/css/vendor.min.css" />
    @* Color Admin core styles *@
    <link rel="stylesheet" href="~/lib/theme/dist/css/app.min.css" />
    @* Custom app overrides (always last) *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Market.Client.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="app" class="app app-header-fixed">

        @* --- TOP HEADER ----------------------------------------------- *@
        <div id="header" class="app-header">

            @* Brand *@
            <div class="navbar-header">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                    <span class="navbar-logo"></span>
                    <b>Market</b>Place
                </a>
            </div>

            @* Left nav links *@
            <div class="navbar-nav">
                <div class="navbar-item">
                    <a asp-controller="Home" asp-action="Index" class="navbar-link">
                        <i class="fa fa-home fa-fw me-1"></i> Home
                    </a>
                </div>
                <div class="navbar-item">
                    <a asp-controller="Home" asp-action="Privacy" class="navbar-link">
                        <i class="fa fa-shield-alt fa-fw me-1"></i> Privacy
                    </a>
                </div>
            </div>

            @* Right nav links *@
            <div class="navbar-nav ms-auto">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    @await Html.PartialAsync("_UserDropdown")
                }
                else
                {
                    <div class="navbar-item">
                        <a asp-controller="Account" asp-action="Login" class="navbar-link">
                            <i class="fa fa-sign-in-alt fa-fw me-1"></i> Login
                        </a>
                    </div>
                    <div class="navbar-item">
                        <a asp-controller="Account" asp-action="Register" class="navbar-link">
                            <i class="fa fa-user-plus fa-fw me-1"></i> Register
                        </a>
                    </div>
                }
                @* Theme toggle *@
                <div class="navbar-item">
                    <button id="btnThemeToggle"
                            class="navbar-link theme-toggle-btn"
                            title="Toggle light / dark theme"
                            onclick="AppJs.theme.toggle()">
                        <span id="themeIcon" aria-hidden="true">&#x1F319;</span>
                        <span class="visually-hidden">Toggle theme</span>
                    </button>
                </div>
            </div>

        </div>
        @* --- END HEADER ------------------------------------------------ *@

        @* --- MAIN CONTENT ---------------------------------------------- *@
        <div id="content" class="app-content">
            <div class="container py-4">
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </div>
        @* --- END CONTENT ----------------------------------------------- *@

        @* --- FOOTER ---------------------------------------------------- *@
        <div id="footer" class="app-footer">
            <div class="container">
                &copy; 2026 - MarketPlace &mdash;
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
        @* --- END FOOTER ------------------------------------------------- *@

    </div>@* #app *@

    @* Color Admin vendor bundle (jQuery + Bootstrap 5 JS + plugins) *@
    <script src="~/lib/theme/dist/js/vendor.min.js"></script>
    @* Color Admin core JS (sidebar, navbar, animations) *@
    <script src="~/lib/theme/dist/js/app.min.js"></script>
    @* Custom app JS (AppJs.toast / AppJs.crud / AppJs.theme) *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @* TempData toast triggers *@
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <script>$(function () { AppJs.toast.success('@Html.Raw(successMsg)'); });</script>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <script>$(function () { AppJs.toast.error('@Html.Raw(errorMsg)'); });</script>
    }
    @if (TempData["WarningMessage"] is string warningMsg)
    {
        <script>$(function () { AppJs.toast.warning('@Html.Raw(warningMsg)'); });</script>
    }
</body>
</html>

